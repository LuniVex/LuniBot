# ── Modmail Bot Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values. Never commit .env.
# IDs: in Discord, enable Settings > Advanced > Developer Mode, then right-click
# a server / channel / role and choose "Copy ID".

# Bot token. Discord Developer Portal > your application > Bot > Reset Token.
# Also enable the Message Content and Server Members intents on that page.
DISCORD_TOKEN=your_bot_token_here

# ID of the Discord server (guild) the bot operates in.
GUILD_ID=your_server_id_here

# ID of the single text channel where ticket threads are created.
TICKETS_CHANNEL_ID=your_tickets_channel_id_here

# ID of the private channel where transcript files are archived.
ARCHIVE_CHANNEL_ID=your_archive_channel_id_here

# ID of the role that grants access to modmail commands.
STAFF_ROLE_ID=your_staff_role_id_here

# (Optional) ID of the channel that receives alerts when a ticket is unclaimed.
# Can also be set in Discord with /config helpchannel.
MOD_HELP_CHANNEL_ID=

# (Optional) Absolute path to the SQLite database file.
# Defaults to ./data/modmail.db when empty.
DATABASE_PATH=
