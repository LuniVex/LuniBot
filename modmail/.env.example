# ── Modmail Bot Environment Variables ──────────────────────────
# Copy this file to .env and fill in the values.

# Bot token from Discord Developer Portal
DISCORD_TOKEN=

# The ID of the Discord server (guild) the bot operates in
GUILD_ID=

# The ID of the single dedicated text channel where ticket threads are created
TICKETS_CHANNEL_ID=

# The ID of the private channel where transcript files are archived
ARCHIVE_CHANNEL_ID=

# The ID of the role that grants access to modmail commands
STAFF_ROLE_ID=

# (Optional) Absolute path to the SQLite database file
DATABASE_PATH=
