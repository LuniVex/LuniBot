# Copy to .env and fill in. Real environment variables override this file.
# Never commit .env (it is gitignored).

# ---------------------------------------------------------------- Discord (required)
# Bot token: Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# Application ID (General Information). Optional: detected at login; needed for `npm run deploy-commands`.
DISCORD_CLIENT_ID=
# Register slash commands instantly in one test server. Leave empty for global commands (can take up to an hour the first time).
DEV_GUILD_ID=
REGISTER_COMMANDS_ON_START=true
# Plain-message requests in a music channel. Needs the privileged "Message Content" intent;
# if the intent isn't enabled the bot logs a warning and runs without it.
ENABLE_MESSAGE_TRIGGER=true

# ---------------------------------------------------------------- Spotify (optional, free)
# Without these, Spotify links are read from Spotify's public embed page.
# Note (Feb 2026): Development Mode apps need an app owner with Spotify Premium, and the API only
# returns playlist contents for playlists the owner owns. The embed fallback covers the rest.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------- Lyrics (all optional)
# LRCLIB (primary, synced lyrics) needs no key. These add fallback providers; each is skipped if unset.
# Musixmatch official API key. Free plan: partial plain lyrics only; synced subtitles need a commercial plan.
MUSIXMATCH_API_KEY=
# Genius API client access token (https://genius.com/api-clients). Plain lyrics only.
GENIUS_ACCESS_TOKEN=
# Provider order, comma-separated (default: lrclib,musixmatch,genius)
LYRICS_PROVIDERS=
# Sent to providers; LRCLIB asks clients to identify themselves.
LYRICS_USER_AGENT=

# ---------------------------------------------------------------- Search
# Sites tried for typed searches, Spotify matching and replacing blocked songs, in order.
# Default: youtube,soundcloud,bandcamp,audius,mixcloud,archive (all free, no keys)
SEARCH_PROVIDERS=

# ---------------------------------------------------------------- yt-dlp / YouTube
# Netscape-format cookies.txt from a logged-in browser. Fixes "Sign in to confirm you're not a bot",
# age-restricted videos and Vimeo. Use a throwaway account. The file is copied, never modified.
YTDLP_COOKIES_FILE=
# YouTube player clients, comma-separated. "default" = yt-dlp's maintained set.
YTDLP_PLAYER_CLIENTS=default
# Retried once when the primary clients are blocked. "none" disables the retry.
YTDLP_FALLBACK_PLAYER_CLIENTS=web_embedded,web_safari,android_vr
# nightly (recommended by yt-dlp for YouTube) or stable
YTDLP_UPDATE_CHANNEL=nightly
# Refresh yt-dlp on every start
YTDLP_AUTO_UPDATE=true
# auto (venv if Python >= 3.10, else standalone binary) | venv | binary
YTDLP_INSTALL_MODE=auto
# Use your own yt-dlp instead of the managed one (then you update it yourself)
YTDLP_PATH=
# JS runtime for YouTube challenges, e.g. "deno" or "node:/usr/bin/node". Default: the Node running the bot.
YTDLP_JS_RUNTIME=
# ffmpeg binary. Default: ffmpeg on PATH, else the ffmpeg-static npm package.
FFMPEG_PATH=

# ---------------------------------------------------------------- Runtime
DATABASE_PATH=data/bot.sqlite
DATA_DIR=data
HEALTH_PORT=8080
# trace | debug | info | warn | error
LOG_LEVEL=info
CONFIG_PATH=config.json

# ---------------------------------------------------------------- Overrides for config.json (optional)
DEFAULT_VOLUME=
MAX_QUEUE_SIZE=
MAX_PLAYLIST_ITEMS=
# Comma-separated channel IDs; empty = everywhere
ALLOWED_TEXT_CHANNELS=
ALLOWED_VOICE_CHANNELS=
# Default DJ role for servers that haven't set one with /settings dj-role
DJ_ROLE_ID=
MAX_CONCURRENT_EXTRACTIONS=
