{
  "name": "music-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord music bot: yt-dlp + @discordjs/voice + FFmpeg, with synced live lyrics",
  "author": "LuniVex",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuniVex/lunibot.git",
    "directory": "music bot"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "smoke": "node scripts/smoke.js",
    "smoke:lyrics": "node scripts/lyrics-smoke.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "pino": "^10.4.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "better-sqlite3": false
  }
}
