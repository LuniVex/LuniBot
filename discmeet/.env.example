# DiscMeet Bot Environment Variables
# Copy this file to .env and fill in your values

# Discord Bot Token — get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application (Client) ID — get from Developer Portal → General Information
CLIENT_ID=your_client_id_here

# OpenAI API Key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# (Optional) Whisper model — defaults to whisper-1
WHISPER_MODEL=whisper-1

# (Optional) Summary model — defaults to gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini

# (Optional) Silence duration in ms before a segment ends — defaults to 300
SILENCE_DURATION=300

# (Optional) Dedicated log/archive channel ID — session headers, transcripts,
# and summaries are posted and pinned here. Falls back to the command channel.
LOG_CHANNEL_ID=

# (Optional) Bot idle status message — shown when no recording is active.
# Defaults to "Watching over meetings"
IDLE_STATUS=Watching over meetings
