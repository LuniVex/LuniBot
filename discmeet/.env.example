# DiscMeet Bot Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# Discord bot token. Developer Portal > your application > Bot > Reset Token.
# https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord application (client) ID. Developer Portal > General Information.
CLIENT_ID=your_client_id_here

# OpenAI API key, used for transcription and notes (usage is billed by OpenAI).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Whisper model for transcription. Defaults to whisper-1.
WHISPER_MODEL=whisper-1

# (Optional) Model that writes the meeting notes. Defaults to gpt-4o-mini.
SUMMARY_MODEL=gpt-4o-mini

# (Optional) Milliseconds of silence before a speech segment ends. Defaults to 300.
SILENCE_DURATION=300

# (Optional) ID of the channel where session headers, transcripts and summaries
# are posted and pinned. Falls back to the channel the command was used in.
LOG_CHANNEL_ID=

# (Optional) Bot status text shown when no recording is active.
# Defaults to "Watching over meetings".
IDLE_STATUS=Watching over meetings

# (Optional) Set to any value (e.g. 1) to print debug logs.
DEBUG=
