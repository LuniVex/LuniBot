{
  "name": "discmeet-bot",
  "version": "1.0.0",
  "description": "AI-powered Discord meeting note-taker bot — records voice channels, transcribes with Whisper, and generates structured meeting notes with GPT.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src src/index.js",
    "deploy": "node src/deploy-commands.js"
  },
  "keywords": [
    "discord",
    "meeting",
    "transcription",
    "whisper",
    "ai",
    "notes",
    "expenses"
  ],
  "author": "LuniVex",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "libsodium-wrappers": "^0.8.4",
    "openai": "^4.70.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "tweetnacl": "^1.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
