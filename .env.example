
# Optional. Canonical site URL used for OpenGraph, sitemap and robots.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this is empty.
NEXT_PUBLIC_SITE_URL=

# Required in production (Vercel): connect "Upstash Redis" from Vercel > Storage (Marketplace).
# Vercel then injects these automatically. Without them, the stats and vote API routes return 503
# on Vercel. Locally they are optional: a JSON file in .data/ is used instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
