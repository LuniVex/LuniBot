# Optional. Canonical URL for OpenGraph, sitemap and robots.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this is empty.
NEXT_PUBLIC_SITE_URL=

# Datastore for download counts and votes: Upstash Redis.
# On Vercel, add "Upstash for Redis" under Storage (Marketplace); it injects these two variables.
# Required in production. Locally they are optional: counts go to .data/store.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names, read when the KV_* pair is unset (a direct Upstash integration sets these).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
